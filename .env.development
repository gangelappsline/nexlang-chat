# ---------------------------------------------------------------------------
# DESARROLLO · se carga con `npm run dev` (vite --mode development)
# ---------------------------------------------------------------------------

VITE_ENVIRONMENT=development

# Base de todas las peticiones (sin barra final). Las rutas ya incluyen /v1/chat:
#   VITE_BASE_API_URL + "/v1/chat/login-code"
#   → http://127.0.0.1:8000/api/v1/chat/login-code
VITE_BASE_API_URL=http://127.0.0.1:8000/api

VITE_DEBUG_REQUESTS=true
