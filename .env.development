# ---------------------------------------------------------------------------
# DESARROLLO · se carga con `npm run dev` (vite --mode development)
# ---------------------------------------------------------------------------

VITE_ENVIRONMENT=development

# Base de todas las peticiones (sin barra final). Las rutas ya incluyen /v1/chat:
#   VITE_BASE_API_URL + "/v1/chat/login-code"
#   → http://127.0.0.1:8000/api/v1/chat/login-code
VITE_BASE_API_URL=http://127.0.0.1:8000/api

VITE_DEBUG_REQUESTS=true

# ---------------------------------------------------------------------------
# Llamadas y videollamadas (WebRTC propio, sin servicios de terceros)
# ---------------------------------------------------------------------------
# Servidor de señalización incluido en el repo (server/signaling).
#   auto  → mismo origen (`ws://localhost:5176/signaling`), que Vite redirige
#           al proceso de `npm run signaling` en :8081 (recomendado en local).
# También puedes apuntar a una URL absoluta: ws://127.0.0.1:8081
VITE_SIGNALING_URL=auto

# Servidores ICE. Para llamadas fiables detrás de NAT hace falta un TURN
# propio (coturn); los STUN solo descubren la red pública.
# Formato: lista separada por comas. Ejemplo con coturn:
#   VITE_STUN_URLS=stun:turn.nexlang.io:3478
#   VITE_TURN_URL=turn:turn.nexlang.io:3478
#   VITE_TURN_USERNAME=nexlang
#   VITE_TURN_CREDENTIAL=secreto
VITE_STUN_URLS=
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
