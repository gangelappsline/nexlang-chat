# ---------------------------------------------------------------------------
# DESARROLLO · se carga con `npm run dev` (vite --mode development)
# ---------------------------------------------------------------------------

VITE_ENVIRONMENT=development

# Base de todas las peticiones. Sin barra final:
#   VITE_BASE_API_URL + "/auth/request-code"  →  http://localhost:4000/api/auth/request-code
VITE_BASE_API_URL=http://localhost:4000/api

# true  → backend demo incluido en src/mocks (no requiere servidor)
# false → peticiones reales a VITE_BASE_API_URL
VITE_USE_MOCK_API=true

VITE_DEBUG_REQUESTS=true
