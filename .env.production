# ---------------------------------------------------------------------------
# PRODUCCIÓN · se carga con `npm run build` (vite build --mode production)
# ---------------------------------------------------------------------------

VITE_ENVIRONMENT=production
VITE_BASE_API_URL=https://api.nexlang.io/v1

# Se deja el backend demo activo para que el build funcione sin API desplegada.
# Cuando el backend real esté listo: cambia este valor a `false`.
VITE_USE_MOCK_API=true

VITE_DEBUG_REQUESTS=false
