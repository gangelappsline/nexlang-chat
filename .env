# ---------------------------------------------------------------------------
# Nexlang Chat · variables compartidas por TODOS los entornos
#
# Vite carga los .env en este orden (el último gana):
#   .env  →  .env.local  →  .env.[modo]  →  .env.[modo].local
#
# Solo las variables con prefijo VITE_ llegan al navegador.
# Los secretos reales deben vivir en .env.local (no se versiona).
# ---------------------------------------------------------------------------

VITE_APP_NAME=Nexlang Chat

# Tiempo máximo (ms) antes de cancelar una petición a la API.
VITE_REQUEST_TIMEOUT_MS=20000

# Registra cada petición HTTP en la consola del navegador.
VITE_DEBUG_REQUESTS=false
