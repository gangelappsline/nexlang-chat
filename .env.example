# ---------------------------------------------------------------------------
# Nexlang Chat · variables de entorno
# ---------------------------------------------------------------------------

# URL base de la API real. Si se deja vacía, la app usa el backend demo
# incluido en `src/mocks` (no requiere servidor).
VITE_API_BASE_URL=

# Con un backend real, cambia a "false" para dejar de usar el backend demo.
# Sin VITE_API_BASE_URL la app siempre trabaja en modo demo.
VITE_USE_MOCK_API=true
