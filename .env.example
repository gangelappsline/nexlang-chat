# ---------------------------------------------------------------------------
# Nexlang Chat · plantilla de variables de entorno
#
# Cópialo a `.env.local` para sobrescribir valores sin tocar los archivos
# versionados. Vite los carga en este orden (el último gana):
#
#   .env  →  .env.local  →  .env.[modo]  →  .env.[modo].local
#
# Modos disponibles: development (`npm run dev`), staging (`npm run dev:staging`)
# y production (`npm run build`). Solo las variables con prefijo VITE_ llegan
# al navegador: nunca guardes secretos en ellas.
# ---------------------------------------------------------------------------

VITE_APP_NAME=Nexlang Chat

# Entorno lógico de la app (se muestra en el menú de cuenta).
VITE_ENVIRONMENT=development

# URL base de la API, sin barra final. Las rutas ya incluyen el prefijo /v1/chat:
#   POST ${VITE_BASE_API_URL}/v1/chat/login-code
VITE_BASE_API_URL=http://localhost:3000

# Milisegundos antes de cancelar una petición (por defecto 20000).
VITE_REQUEST_TIMEOUT_MS=20000

# Loguea método + URL de cada petición en la consola.
VITE_DEBUG_REQUESTS=false
